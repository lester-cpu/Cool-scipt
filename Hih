--==================================================
-- SLIDER
--==================================================

local function createSlider(
	parent,
	text,
	minValue,
	maxValue,
	defaultValue
)

	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1,-8,0,62)
	holder.BackgroundColor3 = ELEMENT
	holder.BorderSizePixel = 0
	holder.Parent = parent

	round(holder,11)

	local nameLabel = Instance.new("TextLabel")
	nameLabel.BackgroundTransparency = 1
	nameLabel.Position = UDim2.new(0,12,0,7)
	nameLabel.Size = UDim2.new(0.5,0,0,20)
	nameLabel.Font = Enum.Font.GothamMedium
	nameLabel.Text = text
	nameLabel.TextColor3 = WHITE
	nameLabel.TextSize = 12
	nameLabel.TextXAlignment = Enum.TextXAlignment.Left
	nameLabel.Parent = holder

	local bar = Instance.new("Frame")
	bar.BackgroundColor3 = Color3.fromRGB(50,50,50)
	bar.Position = UDim2.new(0,12,0,34)
	bar.Size = UDim2.new(1,-24,0,18)
	bar.BorderSizePixel = 0
	bar.Parent = holder

	round(bar,20)

	local fill = Instance.new("Frame")
	fill.BackgroundColor3 = CYAN
	fill.BorderSizePixel = 0
	fill.Size = UDim2.new(0,0,1,0)
	fill.Parent = bar

	round(fill,20)

	local valueBubble = Instance.new("TextLabel")
	valueBubble.BackgroundColor3 = CYAN
	valueBubble.AnchorPoint = Vector2.new(0.5,0.5)
	valueBubble.Size = UDim2.new(0,48,0,24)
	valueBubble.Font = Enum.Font.GothamBold
	valueBubble.TextColor3 = Color3.fromRGB(10,10,10)
	valueBubble.TextSize = 11
	valueBubble.Text = tostring(defaultValue)
	valueBubble.ZIndex = 3
	valueBubble.Parent = bar

	round(valueBubble,20)

	local value = defaultValue
	local dragging = false

	local function setValueFromX(x)

		local percentage = math.clamp(
			(x - bar.AbsolutePosition.X) /
				bar.AbsoluteSize.X,
			0,
			1
		)

		value = math.floor(
			minValue +
			((maxValue-minValue) * percentage) +
			0.5
		)

		local percent =
			(value-minValue) /
			(maxValue-minValue)

		fill.Size =
			UDim2.new(
				percent,
				0,
				1,
				0
			)

		valueBubble.Position =
			UDim2.new(
				percent,
				0,
				0.5,
				0
			)

		valueBubble.Text =
			tostring(value)
	end

	bar.InputBegan:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			dragging = true

			setValueFromX(
				input.Position.X
			)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)

		if dragging and (
			input.UserInputType ==
			Enum.UserInputType.MouseMovement
			or input.UserInputType ==
			Enum.UserInputType.Touch
		) then

			setValueFromX(
				input.Position.X
			)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			dragging = false
		end
	end)

	local function getValue()
		return value
	end

	local function setValue(newValue)

		value = math.clamp(
			math.floor(newValue),
			minValue,
			maxValue
		)

		local percent =
			(value-minValue) /
			(maxValue-minValue)

		fill.Size =
			UDim2.new(
				percent,
				0,
				1,
				0
			)

		valueBubble.Position =
			UDim2.new(
				percent,
				0,
				0.5,
				0
			)

		valueBubble.Text =
			tostring(value)
	end

	task.defer(function()
		setValue(defaultValue)
	end)

	return holder,getValue,setValue
end

