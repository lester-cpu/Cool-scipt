player.CharacterAdded:Connect(function()

	task.wait(1)

	local humanoid = getHumanoid()

	if humanoid then

		humanoid.WalkSpeed =
			walkSpeed

		humanoid.UseJumpPower = true

		humanoid.JumpPower =
			jumpPower
	end

	if antiFling then
		updateAntiFling()
	end

	if espEnabled then

		task.wait(1)

		for _, target in ipairs(Players:GetPlayers()) do

			if target ~= player then
				addESP(target)
			end
		end
	end
end)

