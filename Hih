--------------------------------------------------
-- ANTI FLING
--------------------------------------------------

local function updateAntiFling()

	for _, target in ipairs(Players:GetPlayers()) do

		if target ~= player then

			local character = target.Character

			if character then

				for _, part in ipairs(character:GetDescendants()) do

					if part:IsA("BasePart") then
						part.CanCollide = not antiFling
					end
				end
			end
		end
	end
end

antiButton.MouseButton1Click:Connect(function()

	antiFling = not antiFling

	antiButton.Text =
		"Anti Fling    " ..
		(antiFling and "ON" or "OFF")

	updateAntiFling()
end)

--------------------------------------------------
-- SAVE SETTINGS
--------------------------------------------------

local function getCurrentSettings()

	return {
		walkSpeed = getWalkSpeed(),
		jumpPower = getJumpPower(),
		flySpeed = getFlySpeed(),

		flying = flying,
		espEnabled = espEnabled,
		noclip = noclip,
		infiniteJump = infiniteJump,
		walkFling = walkFling,
		antiFling = antiFling,

		background = window.BackgroundColor3
	}
end

local function updateSavedList()

	local names = {}

	for name in pairs(savedPresets) do
		table.insert(names, name)
	end

	table.sort(names)

	if #names == 0 then
		savedList.Text = "Saved presets: None"
	else
		savedList.Text =
			"Saved presets: " ..
			table.concat(names, ", ")
	end
end

saveButton.MouseButton1Click:Connect(function()

	local name =
		presetName.Text:gsub("^%s*(.-)%s*$", "%1")

	if name == "" then
		return
	end

	savedPresets[name] = getCurrentSettings()

	updateSavedList()

	saveButton.Text = "Saved: " .. name

	task.delay(1.5, function()
		if saveButton.Parent then
			saveButton.Text =
				"Save Current Settings"
		end
	end)
end)

--------------------------------------------------
-- LOAD SETTINGS
--------------------------------------------------

loadButton.MouseButton1Click:Connect(function()

	local name =
		loadName.Text:gsub("^%s*(.-)%s*$", "%1")

	local settings =
		savedPresets[name]

	if not settings then

		loadButton.Text = "Preset Not Found"

		task.delay(1.5, function()
			if loadButton.Parent then
				loadButton.Text =
					"Load Saved Settings"
			end
		end)

		return
	end

	------------------------------------------------
	-- VALUES
	------------------------------------------------

	setWalkSpeed(settings.walkSpeed)
	setJumpPower(settings.jumpPower)
	setFlySpeed(settings.flySpeed)

	walkSpeed = settings.walkSpeed
	jumpPower = settings.jumpPower
	flySpeed = settings.flySpeed

	------------------------------------------------
	-- TOGGLES
	------------------------------------------------

	if infiniteJump ~= settings.infiniteJump then
		infiniteJump = settings.infiniteJump

		infiniteJumpButton.Text =
			"Infinite Jump    " ..
			(infiniteJump and "ON" or "OFF")
	end

	if noclip ~= settings.noclip then
		noclip = settings.noclip

		noclipButton.Text =
			"Noclip    " ..
			(noclip and "ON" or "OFF")
	end

	if espEnabled ~= settings.espEnabled then

		if settings.espEnabled then
			enableESP()
		else
			disableESP()
		end
	end

	if walkFling ~= settings.walkFling then

		walkFling = settings.walkFling

		walkFlingButton.Text =
			"Walk Fling    " ..
			(walkFling and "ON" or "OFF")
	end

	if antiFling ~= settings.antiFling then

		antiFling = settings.antiFling

		antiButton.Text =
			"Anti Fling    " ..
			(antiFling and "ON" or "OFF")

		updateAntiFling()
	end

	if flying ~= settings.flying then

		if settings.flying then
			startFly()
		else
			stopFly()
		end
	end

	------------------------------------------------
	-- BACKGROUND
	------------------------------------------------

	window.BackgroundColor3 =
		settings.background

	loadButton.Text = "Loaded: " .. name

	task.delay(1.5, function()
		if loadButton.Parent then
			loadButton.Text =
				"Load Saved Settings"
		end
	end)
end)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(function()

	local character = getCharacter()

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	------------------------------------------------
	-- SLIDER VALUES
	------------------------------------------------

	walkSpeed = getWalkSpeed()
	jumpPower = getJumpPower()
	flySpeed = getFlySpeed()

	------------------------------------------------
	-- PLAYER SETTINGS
	------------------------------------------------

	if humanoid then

		humanoid.WalkSpeed =
			walkSpeed

		humanoid.UseJumpPower = true

		humanoid.JumpPower =
			jumpPower
	end

	------------------------------------------------
	-- NOCLIP
	------------------------------------------------

	if noclip then

		for _, part in ipairs(character:GetDescendants()) do

			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	------------------------------------------------
	-- WALK FLING
	------------------------------------------------

	if walkFling and root then

		-- Extremely fast spinning
		root.AssemblyAngularVelocity =
			Vector3.new(0, 100000, 0)

		for _, target in ipairs(Players:GetPlayers()) do

			if target ~= player then

				local targetCharacter =
					target.Character

				local targetRoot =
					targetCharacter and
					targetCharacter:FindFirstChild(
						"HumanoidRootPart"
					)

				if targetRoot then

					local distance =
						(root.Position -
							targetRoot.Position).Magnitude

					if distance <= 4 then

						local now = os.clock()

						if not flingCooldown[target]
							or now -
							flingCooldown[target] > 0.5 then

							flingCooldown[target] = now

							local direction =
								targetRoot.Position -
								root.Position

							if direction.Magnitude > 0 then
								direction =
									direction.Unit
							else
								direction =
									Vector3.new(1, 0, 0)
							end

							targetRoot.AssemblyLinearVelocity =
								direction * 100 +
								Vector3.new(0, 60, 0)
						end
					end
				end
			end
		end

	else

		if root then
			root.AssemblyAngularVelocity =
				Vector3.zero
		end
	end

	------------------------------------------------
	-- ANTI FLING
	------------------------------------------------

	if antiFling then
		updateAntiFling()
	end
end)

