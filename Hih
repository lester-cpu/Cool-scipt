-- ANTI FLING
--------------------------------------------------

local function updateAntiFling()
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			local character = target.Character

			if character then
				for _, part in ipairs(character:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = not antiFling
					end
				end
			end
		end
	end
end

antiButton.MouseButton1Click:Connect(function()
	antiFling = not antiFling

	antiButton.Text =
		"Anti Fling    " ..
		(antiFling and "ON" or "OFF")

	updateAntiFling()
end)

--------------------------------------------------
-- MAIN LOOP
--------------------------------------------------

RunService.Heartbeat:Connect(function()
	local character = getCharacter()

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if humanoid then
		humanoid.WalkSpeed = walkSpeed
		humanoid.UseJumpPower = true
		humanoid.JumpPower = jumpPower
	end

	------------------------------------------------
	-- NOCLIP
	------------------------------------------------

	if noclip then
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
	end

	------------------------------------------------
	-- WALK FLING
	------------------------------------------------

	if walkFling and root then

		-- Extremely fast spinning
		root.AssemblyAngularVelocity =
			Vector3.new(0, 100000, 0)

		for _, target in ipairs(Players:GetPlayers()) do
			if target ~= player then

				local targetCharacter =
					target.Character

				local targetRoot =
					targetCharacter and
					targetCharacter:FindFirstChild(
						"HumanoidRootPart"
					)

				if targetRoot then
					local distance =
						(root.Position -
							targetRoot.Position).Magnitude

					if distance <= 4 then
						local now = os.clock()

						if not flingCooldown[target]
							or now -
							flingCooldown[target] > 0.5 then

							flingCooldown[target] = now

							local direction =
								targetRoot.Position -
								root.Position

							if direction.Magnitude > 0 then
								direction =
									direction.Unit
							else
								direction =
									Vector3.new(1, 0, 0)
							end

							targetRoot.AssemblyLinearVelocity =
								direction * 100 +
								Vector3.new(0, 60, 0)
						end
					end
				end
			end
		end
	else
		if root then
			root.AssemblyAngularVelocity =
				Vector3.zero
		end
	end

	------------------------------------------------
	-- ANTI FLING
	------------------------------------------------

	if antiFling then
		updateAntiFling()
	end
end)

