--==================================================
-- DRAG MENU FROM ANY EMPTY AREA / EDGE
--==================================================

local draggingMenu = false
local dragStart
local startPosition

local function isInsideInteractive(object)
	if not object then
		return false
	end

	local current = object

	while current and current ~= window do

		if current:IsA("GuiButton") or current:IsA("TextBox") then
			return true
		end

		if current == nav
			or current == content
			or current == colorList
			or current == savedList
			or current == walkSlider
			or current == jumpSlider
			or current == flySlider then

			return true
		end

		current = current.Parent
	end

	return false
end

local function startMenuDrag(input)
	if isInsideInteractive(input.Target) then
		return
	end

	draggingMenu = true
	dragStart = input.Position
	startPosition = window.Position
end

local function moveMenu(input)
	if not draggingMenu then
		return
	end

	local delta = input.Position - dragStart

	window.Position = UDim2.new(
		startPosition.X.Scale,
		startPosition.X.Offset + delta.X,
		startPosition.Y.Scale,
		startPosition.Y.Offset + delta.Y
	)
end

local function stopMenuDrag()
	draggingMenu = false
end

window.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		startMenuDrag(input)
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement
		or input.UserInputType == Enum.UserInputType.Touch then

		moveMenu(input)
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		stopMenuDrag()
	end
end)

--==================================================
-- CHARACTER
--==================================================

local function getCharacter()
	return player.Character
end

local function getHumanoid()
	local character = getCharacter()

	if character then
		return character:FindFirstChildOfClass("Humanoid")
	end
end

local function getRoot()
	local character = getCharacter()

	if character then
		return character:FindFirstChild("HumanoidRootPart")
	end
end

--==================================================
-- INFINITE JUMP
--==================================================

UserInputService.JumpRequest:Connect(function()
	if getInfiniteJump() then
		local humanoid = getHumanoid()

		if humanoid then
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end
	end
end)

--==================================================
-- ESP
--==================================================

local function getHealthColor(health, maxHealth)
	if health <= 0 then
		return PURPLE
	end

	local percent = health / math.max(maxHealth, 1)

	if percent > 0.5 then
		return GREEN
	elseif percent > 0.25 then
		return YELLOW
	else
		return RED
	end
end

local function removeESP(target)
	if espObjects[target] then
		for _, object in ipairs(espObjects[target]) do
			if object then
				object:Destroy()
			end
		end

		espObjects[target] = nil
	end
end

local function addESP(target)
	if target == player then
		return
	end

	removeESP(target)

	local character = target.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	highlight.FillTransparency = 0.65
	highlight.OutlineTransparency = 0
	highlight.OutlineColor = RED
	highlight.Parent = character

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 180, 0, 40)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextScaled = true
	label.Parent = billboard

	local function update()
		if not humanoid.Parent then
			return
		end

		local color = getHealthColor(
			humanoid.Health,
			humanoid.MaxHealth
		)

		label.Text = string.format(
			"%s [%d/%d]",
			target.Name,
			math.floor(humanoid.Health),
			math.floor(humanoid.MaxHealth)
		)

		label.TextColor3 = color
		highlight.FillColor = color
	end

	update()

	local connection = humanoid.HealthChanged:Connect(update)

	table.insert(espObjects, target)

	espObjects[target] = {
		highlight,
		billboard,
		connection
	}
end

local function updateESP()
	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			if espEnabled then
				addESP(target)
			else
				removeESP(target)
			end
		end
	end
end

Players.PlayerAdded:Connect(function(target)
	target.CharacterAdded:Connect(function()
		task.wait(1)

		if getESP() then
			addESP(target)
		end
	end)
end)

Players.PlayerRemoving:Connect(function(target)
	removeESP(target)
end)

--==================================================
-- MAIN LOOP
--==================================================

RunService.Heartbeat:Connect(function()

	local character = getCharacter()
	local humanoid = getHumanoid()
	local root = getRoot()

	if humanoid then
		humanoid.WalkSpeed = getWalkSpeed()
		humanoid.UseJumpPower = true
		humanoid.JumpPower = getJumpPower()
	end

	--==============================
	-- NOCLIP
	--==============================

	if character then
		for _, object in ipairs(character:GetDescendants()) do
			if object:IsA("BasePart") then
				object.CanCollide = not getNoclip()
			end
		end
	end

	--==============================
	-- FLY
	--==============================

	if getFlying() and humanoid and root then
		humanoid.PlatformStand = true

		local camera = workspace.CurrentCamera
		local direction = humanoid.MoveDirection

		if direction.Magnitude > 0 then
			root.AssemblyLinearVelocity =
				direction.Unit * getFlySpeed()
		else
			root.AssemblyLinearVelocity = Vector3.zero
		end

		if camera then
			local look = camera.CFrame.LookVector

			if direction.Magnitude > 0 then
				root.AssemblyLinearVelocity =
					direction.Unit * getFlySpeed()
					+ look * getFlySpeed() * 0.35
			end
		end
	else
		if humanoid then
			humanoid.PlatformStand = false
		end
	end

	--==============================
	-- WALK FLING
	--==============================

	if getWalkFling() and root then
		root.AssemblyAngularVelocity = Vector3.new(0, 100000, 0)

		for _, target in ipairs(Players:GetPlayers()) do
			if target ~= player then
				local targetCharacter = target.Character
				local targetRoot =
					targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")

				if targetRoot then
					local distance =
						(root.Position - targetRoot.Position).Magnitude

					if distance <= 4 then
						if not flingCooldown[target] then
							flingCooldown[target] = true

							local direction =
								(targetRoot.Position - root.Position)

							if direction.Magnitude > 0 then
								direction = direction.Unit
							else
								direction = Vector3.new(1, 0, 0)
							end

							targetRoot.AssemblyLinearVelocity =
								direction * 100
								+ Vector3.new(0, 60, 0)

							task.delay(0.5, function()
								flingCooldown[target] = nil
							end)
						end
					end
				end
			end
		end
	else
		if root then
			root.AssemblyAngularVelocity = Vector3.zero
		end
	end

	--==============================
	-- ANTI FLING
	--==============================

	for _, target in ipairs(Players:GetPlayers()) do
		if target ~= player then
			local targetCharacter = target.Character

			if targetCharacter then
				for _, object in ipairs(targetCharacter:GetDescendants()) do
					if object:IsA("BasePart") then
						if getAntiFling() then
							object.CanCollide = false
						end
					end
				end
			end
		end
	end

	--==============================
	-- ESP
	--==============================

	if getESP() then
		for _, target in ipairs(Players:GetPlayers()) do
			if target ~= player then
				if not espObjects[target] then
					addESP(target)
				end
			end
		end
	else
		for target in pairs(espObjects) do
			removeESP(target)
		end
	end
end)

