local function applySettings(data)
	if not data then
		return
	end

	setWalkSpeed(data.walkSpeed or 16)
	setJumpPower(data.jumpPower or 50)
	setFlySpeed(data.flySpeed or 60)

	setFlying(data.flying or false)
	setESP(data.espEnabled or false)
	setNoclip(data.noclip or false)
	setInfiniteJump(data.infiniteJump or false)
	setWalkFling(data.walkFling or false)
	setAntiFling(data.antiFling or false)

	if data.background and backgroundColors[data.background] then
		currentBackground = data.background
		window.BackgroundColor3 = backgroundColors[data.background]
	end
end

--==================================================
-- UPDATE SAVED FILE LIST
--==================================================

local function updateSavedList()
	for _, child in ipairs(savedList:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	local files = {}

	for name, data in pairs(savedPresets) do
		table.insert(files, {
			name = name,
			data = data
		})
	end

	table.sort(files, function(a, b)
		return (a.data.created or 0) > (b.data.created or 0)
	end)

	if #files == 0 then
		savedLabel.Text = "No saved files"
	else
		savedLabel.Text = #files .. " saved file(s)"
	end

	for _, file in ipairs(files) do
		local button = Instance.new("TextButton")
		button.Size = UDim2.new(1, -10, 0, 52)
		button.BackgroundColor3 = ELEMENT
		button.BorderSizePixel = 0
		button.Text = ""
		button.Parent = savedList

		round(button, 8)

		local nameLabel = Instance.new("TextLabel")
		nameLabel.BackgroundTransparency = 1
		nameLabel.Position = UDim2.new(0, 10, 0, 5)
		nameLabel.Size = UDim2.new(1, -20, 0, 20)
		nameLabel.Font = Enum.Font.GothamMedium
		nameLabel.Text = file.name
		nameLabel.TextColor3 = WHITE
		nameLabel.TextSize = 12
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Parent = button

		local timeLabel = Instance.new("TextLabel")
		timeLabel.BackgroundTransparency = 1
		timeLabel.Position = UDim2.new(0, 10, 0, 27)
		timeLabel.Size = UDim2.new(1, -20, 0, 17)
		timeLabel.Font = Enum.Font.Gotham
		timeLabel.Text = os.date("%b %d, %Y • %I:%M %p", file.data.created)
		timeLabel.TextColor3 = GRAY
		timeLabel.TextSize = 10
		timeLabel.TextXAlignment = Enum.TextXAlignment.Left
		timeLabel.Parent = button

		button.MouseEnter:Connect(function()
			button.BackgroundColor3 = HOVER
		end)

		button.MouseLeave:Connect(function()
			button.BackgroundColor3 = ELEMENT
		end)

		button.MouseButton1Click:Connect(function()
			applySettings(file.data)

			fileNameBox.Text = file.name

			savedList.Visible = false
			loadButton.Text = "Load File     ▼"
		end)
	end
end

