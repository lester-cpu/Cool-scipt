local function createSlider(parent, text, min, max, default)
	local holder = Instance.new("Frame")
	holder.Size = UDim2.new(1, -5, 0, 58)
	holder.BackgroundColor3 = ELEMENT
	holder.BorderSizePixel = 0
	holder.Parent = parent

	round(holder, 9)

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0, 12, 0, 7)
	label.Size = UDim2.new(0.7, 0, 0, 20)
	label.Font = Enum.Font.GothamMedium
	label.Text = text
	label.TextColor3 = WHITE
	label.TextSize = 12
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = holder

	local valueLabel = Instance.new("TextLabel")
	valueLabel.BackgroundTransparency = 1
	valueLabel.Position = UDim2.new(0.7, 0, 0, 7)
	valueLabel.Size = UDim2.new(0.25, 0, 0, 20)
	valueLabel.Font = Enum.Font.GothamBold
	valueLabel.TextColor3 = GREEN
	valueLabel.TextSize = 12
	valueLabel.TextXAlignment = Enum.TextXAlignment.Right
	valueLabel.Parent = holder

	local bar = Instance.new("Frame")
	bar.Position = UDim2.new(0, 12, 0, 34)
	bar.Size = UDim2.new(1, -24, 0, 6)
	bar.BackgroundColor3 = Color3.fromRGB(65, 65, 65)
	bar.BorderSizePixel = 0
	bar.Parent = holder

	round(bar, 6)

	local fill = Instance.new("Frame")
	fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
	fill.BackgroundColor3 = GREEN
	fill.BorderSizePixel = 0
	fill.Parent = bar

	round(fill, 6)

	local knob = Instance.new("Frame")
	knob.AnchorPoint = Vector2.new(0.5, 0.5)
	knob.Position = UDim2.new((default - min) / (max - min), 0, 0.5, 0)
	knob.Size = UDim2.new(0, 14, 0, 14)
	knob.BackgroundColor3 = WHITE
	knob.BorderSizePixel = 0
	knob.Parent = bar

	round(knob, 20)

	local value = default

	local function setValue(newValue)
		value = math.clamp(math.floor(newValue + 0.5), min, max)

		local percent = (value - min) / (max - min)

		fill.Size = UDim2.new(percent, 0, 1, 0)
		knob.Position = UDim2.new(percent, 0, 0.5, 0)
		valueLabel.Text = tostring(value)
	end

	local function updateFromInput(input)
		local x = input.Position.X
		local percent = math.clamp(
			(x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X,
			0,
			1
		)

		setValue(min + (max - min) * percent)
	end

	bar.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then

			updateFromInput(input)

			local connection
			connection = UserInputService.InputChanged:Connect(function(move)
				if move.UserInputType == Enum.UserInputType.MouseMovement
					or move.UserInputType == Enum.UserInputType.Touch then
					updateFromInput(move)
				end
			end)

			local ended
			ended = UserInputService.InputEnded:Connect(function(endInput)
				if endInput.UserInputType == Enum.UserInputType.MouseButton1
					or endInput.UserInputType == Enum.UserInputType.Touch then

					connection:Disconnect()
					ended:Disconnect()
				end
			end)
		end
	end)

	setValue(default)

	return holder, function()
		return value
	end, setValue
end

local function createToggle(parent, text, default)
	local button = createButton(parent, text .. "  OFF")
	local state = default or false

	local function update()
		if state then
			button.Text = text .. "  ON"
			button.TextColor3 = GREEN
		else
			button.Text = text .. "  OFF"
			button.TextColor3 = WHITE
		end
	end

	button.MouseButton1Click:Connect(function()
		state = not state
		update()
	end)

	update()

	return button, function()
		return state
	end, function(value)
		state = value == true
		update()
	end
end

