--==================================================
-- FLY
--==================================================

local flyConnection

local function startFlying()
	if flying then
		return
	end

	flying = true
	flyButton.Text = "FLY: ON"

	local humanoid = getHumanoid()

	if humanoid then
		humanoid.PlatformStand = true
	end

	flyConnection = RunService.RenderStepped:Connect(function()
		if not flying then
			return
		end

		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")

		if not root then
			return
		end

		local camera = workspace.CurrentCamera

		if not camera then
			return
		end

		local moveDirection = humanoid and humanoid.MoveDirection

		if moveDirection and moveDirection.Magnitude > 0 then
			local lookDirection = camera.CFrame.LookVector

			root.AssemblyLinearVelocity =
				lookDirection.Unit * flySpeed

			root.CFrame =
				CFrame.lookAt(
					root.Position,
					root.Position + lookDirection
				)
		else
			root.AssemblyLinearVelocity = Vector3.zero
		end
	end)
end

local function stopFlying()
	flying = false
	flyButton.Text = "FLY: OFF"

	if flyConnection then
		flyConnection:Disconnect()
		flyConnection = nil
	end

	local humanoid = getHumanoid()

	if humanoid then
		humanoid.PlatformStand = false
	end

	local root = getRoot()

	if root then
		root.AssemblyLinearVelocity = Vector3.zero
	end
end

flyButton.MouseButton1Click:Connect(function()
	if flying then
		stopFlying()
	else
		startFlying()
	end
end)

flySpeedBox.FocusLost:Connect(function()
	local number = tonumber(flySpeedBox.Text)

	if number then
		flySpeed = number
	end
end)

--==================================================
-- ESP
--==================================================

local function getHealthColor(humanoid)
	if humanoid.Health <= 0 then
		return Color3.fromRGB(170, 0, 255)
	end

	local percentage =
		humanoid.Health / humanoid.MaxHealth

	if percentage <= 0.25 then
		return Color3.fromRGB(255, 0, 0)
	elseif percentage <= 0.50 then
		return Color3.fromRGB(255, 255, 0)
	else
		return Color3.fromRGB(0, 255, 0)
	end
end

local function addESP(targetPlayer)
	if targetPlayer == player then
		return
	end

	local character = targetPlayer.Character

	if not character then
		return
	end

	if espObjects[targetPlayer] then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass("Humanoid")

	local root =
		character:FindFirstChild("HumanoidRootPart")

	if not humanoid or not root then
		return
	end

	local highlight = Instance.new("Highlight")
	highlight.FillTransparency = 0.5
	highlight.OutlineTransparency = 0
	highlight.OutlineColor = RED
	highlight.Parent = character

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.new(0, 220, 0, 50)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = root

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.SourceSansBold
	label.TextScaled = true
	label.TextStrokeTransparency = 0
	label.Parent = billboard

	local function update()
		if not humanoid.Parent then
			return
		end

		local health =
			math.max(0, math.floor(humanoid.Health))

		local maxHealth =
			math.max(1, math.floor(humanoid.MaxHealth))

		local healthColor =
			getHealthColor(humanoid)

		label.Text =
			targetPlayer.Name ..
			" [" ..
			health ..
			"/" ..
			maxHealth ..
			"]"

		label.TextColor3 = healthColor
		highlight.FillColor = healthColor
	end

	update()

	local connection =
		humanoid.HealthChanged:Connect(update)

	espObjects[targetPlayer] = {
		highlight = highlight,
		billboard = billboard,
		connection = connection
	}
end

local function removeESP(targetPlayer)
	local object = espObjects[targetPlayer]

	if not object then
		return
	end

	if object.connection then
		object.connection:Disconnect()
	end

	if object.highlight then
		object.highlight:Destroy()
	end

	if object.billboard then
		object.billboard:Destroy()
	end

	espObjects[targetPlayer] = nil
end

local function enableESP()
	espEnabled = true
	espButton.Text = "ESP: ON"

	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		addESP(targetPlayer)
	end
end

local function disableESP()
	espEnabled = false
	espButton.Text = "ESP: OFF"

	for targetPlayer in pairs(espObjects) do
		removeESP(targetPlayer)
	end
end

espButton.MouseButton1Click:Connect(function()
	if espEnabled then
		disableESP()
	else
		enableESP()
	end
end)

Players.PlayerAdded:Connect(function(targetPlayer)
	targetPlayer.CharacterAdded:Connect(function()
		task.wait(1)

		if espEnabled then
			addESP(targetPlayer)
		end
	end)
end)

Players.PlayerRemoving:Connect(function(targetPlayer)
	removeESP(targetPlayer)
end)

