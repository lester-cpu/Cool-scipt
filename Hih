--==================================================
-- UNIVERSAL SURFACE WALK
-- FLOOR / WALL / CEILING / SLOPES
--==================================================

local surfaceNormal = nil
local surfaceAttached = false
local surfacePart = nil

local surfaceCameraLocal = nil
local surfaceCameraActive = false

local SURFACE_DISTANCE = 5
local SURFACE_STICK = 8
local SURFACE_SPEED = 1
local SURFACE_SMOOTHNESS = 12
local SURFACE_CAMERA_SMOOTHNESS = 14

local SURFACE_CAMERA_BIND =
	"Playmegamarble_SurfaceCamera"

local function surfaceAlpha(
	speed,
	dt
)

	return 1 -
		math.exp(
			-speed * dt
		)
end

--==================================================
-- SURFACE RAYCAST
--==================================================

local function getSurfaceHit(
	character,
	root
)

	local params =
		RaycastParams.new()

	params.FilterType =
		Enum.RaycastFilterType.Exclude

	params.FilterDescendantsInstances =
		{character}

	params.IgnoreWater =
		true

	-- Check all six major directions.
	local directions = {

		Vector3.new(0,-1,0),
		Vector3.new(0,1,0),

		root.CFrame.LookVector,
		-root.CFrame.LookVector,

		root.CFrame.RightVector,
		-root.CFrame.RightVector
	}

	local closest = nil

	for _,direction in ipairs(
		directions
	) do

		local result =
			workspace:Raycast(
				root.Position,
				direction *
					SURFACE_DISTANCE,
				params
			)

		if result
			and result.Instance then

			if not closest
				or result.Distance <
				closest.Distance then

				closest =
					result
			end
		end
	end

	-- Spherecasts help catch sloped and rounded
	-- surfaces that a single ray can miss.
	local sphereDirections = {

		Vector3.new(0,-1,0),
		Vector3.new(0,1,0),

		root.CFrame.LookVector,
		-root.CFrame.LookVector,

		root.CFrame.RightVector,
		-root.CFrame.RightVector,

		(
			root.CFrame.LookVector +
			root.CFrame.UpVector
		).Unit,

		(
			root.CFrame.LookVector -
			root.CFrame.UpVector
		).Unit,

		(
			root.CFrame.RightVector +
			root.CFrame.UpVector
		).Unit,

		(
			root.CFrame.RightVector -
			root.CFrame.UpVector
		).Unit
	}

	for _,direction in ipairs(
		sphereDirections
	) do

		local result =
			workspace:Spherecast(
				root.Position,
				1.5,
				direction *
					SURFACE_DISTANCE,
				params
			)

		if result
			and result.Instance then

			if not closest
				or result.Distance <
				closest.Distance then

				closest =
					result
			end
		end
	end

	return closest
end

--==================================================
-- SURFACE CAMERA
--==================================================

local function startSurfaceCamera(
	root
)

	local camera =
		workspace.CurrentCamera

	if not camera
		or not root then

		return
	end

	if not surfaceCameraActive then

		surfaceCameraLocal =
			root.CFrame:ToObjectSpace(
				camera.CFrame
			)

		camera.CameraType =
			Enum.CameraType.Scriptable

		surfaceCameraActive =
			true
	end
end

local function stopSurfaceCamera()

	local camera =
		workspace.CurrentCamera

	surfaceCameraActive =
		false

	surfaceCameraLocal =
		nil

	if camera then

		camera.CameraType =
			Enum.CameraType.Custom

		local humanoid =
			getHumanoid()

		if humanoid then

			camera.CameraSubject =
				humanoid
		end
	end
end

RunService:BindToRenderStep(
	SURFACE_CAMERA_BIND,
	Enum.RenderPriority.Camera.Value + 1,
	function(dt)

		if not surfaceCameraActive
			or not surfaceAttached
			or not surfaceCameraLocal then

			return
		end

		local camera =
			workspace.CurrentCamera

		local root =
			getRoot()

		if not camera
			or not root then

			return
		end

		local targetCamera =
			root.CFrame *
			surfaceCameraLocal

		camera.CFrame =
			camera.CFrame:Lerp(
				targetCamera,
				surfaceAlpha(
					SURFACE_CAMERA_SMOOTHNESS,
					dt
				)
			)

		camera.Focus =
			CFrame.new(
				root.Position
			)
	end
)

--==================================================
-- SURFACE MOVEMENT
--==================================================

local function getSurfaceMovement(
	humanoid,
	normal
)

	local camera =
		workspace.CurrentCamera

	if not camera then
		return Vector3.zero
	end

	local move =
		humanoid.MoveDirection

	if move.Magnitude < 0.05 then
		return Vector3.zero
	end

	-- Humanoid.MoveDirection is already based on
	-- the player's movement input. Project it onto
	-- the current surface.
	local surfaceUp =
		normal.Unit

	local movement =
		move -
		surfaceUp *
		move:Dot(surfaceUp)

	if movement.Magnitude < 0.05 then
		return Vector3.zero
	end

	return movement.Unit
end

--==================================================
-- UPDATE SURFACE WALK
--==================================================

local function updateWallWalk(dt)

	if not getWallWalk() then

		if surfaceAttached then

			local humanoid =
				getHumanoid()

			if humanoid then
				humanoid.AutoRotate =
					true
			end

			stopSurfaceCamera()
		end

		surfaceNormal =
			nil

		surfacePart =
			nil

		surfaceAttached =
			false

		return
	end

	local character =
		getCharacter()

	local humanoid =
		getHumanoid()

	local root =
		getRoot()

	if not character
		or not humanoid
		or not root then

		return
	end

	local hit =
		getSurfaceHit(
			character,
			root
		)

	-- Once attached, keep searching around the
	-- current surface normal so transitions such
	-- as wall -> ceiling can happen smoothly.
	if surfaceAttached
		and surfaceNormal then

		local params =
			RaycastParams.new()

		params.FilterType =
			Enum.RaycastFilterType.Exclude

		params.FilterDescendantsInstances =
			{character}

		params.IgnoreWater =
			true

		local currentSurface =
			workspace:Raycast(
				root.Position,
				-surfaceNormal *
					SURFACE_DISTANCE,
				params
			)

		if currentSurface then
			hit =
				currentSurface
		end
	end

	if hit then

		local targetNormal =
			hit.Normal.Unit

		if not surfaceNormal then

			surfaceNormal =
				targetNormal

		else

			local alpha =
				surfaceAlpha(
					SURFACE_SMOOTHNESS,
					dt
				)

			local blended =
				surfaceNormal:Lerp(
					targetNormal,
					alpha
				)

			if blended.Magnitude >
				0.01 then

				surfaceNormal =
					blended.Unit
			end
		end

		surfacePart =
			hit.Instance

		local normal =
			surfaceNormal.Unit

		-- The detected surface normal becomes
		-- the player's new UP direction.
		local surfaceUp =
			normal

		local movement =
			getSurfaceMovement(
				humanoid,
				normal
			)

		local forward

		if movement.Magnitude >
			0.05 then

			forward =
				movement

		else

			local projected =
				root.CFrame.LookVector -
				surfaceUp *
				root.CFrame.LookVector:
				Dot(surfaceUp)

			if projected.Magnitude >
				0.05 then

				forward =
					projected.Unit

			else

				-- Pick any direction lying
				-- along the surface.
				local fallback =
					surfaceUp:Cross(
						Vector3.new(
							1,
							0,
							0
						)
					)

				if fallback.Magnitude <
					0.05 then

					fallback =
						surfaceUp:Cross(
							Vector3.new(
								0,
								0,
								1
							)
						)
				end

				forward =
					fallback.Unit
			end
		end

		local right =
			forward:Cross(
				surfaceUp
			)

		if right.Magnitude >
			0.05 then

			right =
				right.Unit

			local correctedForward =
				surfaceUp:Cross(
					right
				).Unit

			local targetCFrame =
				CFrame.fromMatrix(
					root.Position,
					right,
					surfaceUp,
					-correctedForward
				)

			root.CFrame =
				root.CFrame:Lerp(
					targetCFrame,
					surfaceAlpha(
						SURFACE_SMOOTHNESS,
						dt
					)
				)
		end

		humanoid.AutoRotate =
			false

		-- Pull the character toward the
		-- current surface.
		local stickVelocity =
			-normal *
			SURFACE_STICK

		if movement.Magnitude >
			0.05 then

			root.AssemblyLinearVelocity =
				movement *
				humanoid.WalkSpeed *
				SURFACE_SPEED +
				stickVelocity

		else

			root.AssemblyLinearVelocity =
				stickVelocity
		end

		if not surfaceAttached then

			surfaceAttached =
				true

			startSurfaceCamera(
				root
			)
		end

	else

		if surfaceAttached then

			humanoid.AutoRotate =
				true

			stopSurfaceCamera()
		end

		surfaceNormal =
			nil

		surfacePart =
			nil

		surfaceAttached =
			false
	end
end

--==================================================
-- INFINITE / SURFACE JUMP
--==================================================

UserInputService.JumpRequest:Connect(
	function()

		local humanoid =
			getHumanoid()

		local root =
			getRoot()

		if not humanoid then
			return
		end

		-- Jump perpendicular to whatever surface
		-- the player is currently standing on.
		if surfaceAttached
			and surfaceNormal
			and root then

			local normal =
				surfaceNormal.Unit

			local velocity =
				root.AssemblyLinearVelocity

			local tangent =
				velocity -
				normal *
				velocity:Dot(normal)

			root.AssemblyLinearVelocity =
				tangent +
				normal *
				getJumpPower()

			humanoid:ChangeState(
				Enum.HumanoidStateType.Jumping
			)

			return
		end

		if getInfiniteJump() then

			humanoid:ChangeState(
				Enum.HumanoidStateType.Jumping
			)
		end
	end
)

--==================================================
-- ESP
--==================================================

local function getHealthColor(
	humanoid
)

	local health =
		humanoid.Health

	local maxHealth =
		humanoid.MaxHealth

	if health <= 0 then
		return PURPLE
	end

	local percent =
		health / maxHealth

	if percent > 0.50 then

		return Color3.fromRGB(
			60,
			255,
			100
		)

	elseif percent > 0.25 then

		return YELLOW

	else

		return RED
	end
end

local function removeESP(
	target
)

	if espObjects[target] then

		for _,object in ipairs(
			espObjects[target]
		) do

			if typeof(object) ==
				"RBXScriptConnection" then

				object:Disconnect()

			elseif object then

				object:Destroy()
			end
		end

		espObjects[target] =
			nil
	end
end

local function addESP(
	target
)

	if target == player then
		return
	end

	removeESP(target)

	local character =
		target.Character

	if not character then
		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		character:FindFirstChild(
			"HumanoidRootPart"
		)

	if not humanoid
		or not root then

		return
	end

	local highlight =
		Instance.new(
			"Highlight"
		)

	highlight.FillTransparency =
		0.45

	highlight.OutlineTransparency =
		0

	highlight.OutlineColor =
		RED

	highlight.Parent =
		character

	local billboard =
		Instance.new(
			"BillboardGui"
		)

	billboard.Size =
		UDim2.new(
			0,
			180,
			0,
			35
		)

	billboard.StudsOffset =
		Vector3.new(
			0,
			3,
			0
		)

	billboard.AlwaysOnTop =
		true

	billboard.Parent =
		root

	local label =
		Instance.new(
			"TextLabel"
		)

	label.Size =
		UDim2.new(
			1,
			0,
			1,
			0
		)

	label.BackgroundTransparency =
		1

	label.Font =
		Enum.Font.GothamBold

	label.TextSize =
		12

	label.TextStrokeTransparency =
		0.5

	label.Parent =
		billboard

	local function update()

		if humanoid.Parent == nil then
			return
		end

		local healthColor =
			getHealthColor(
				humanoid
			)

		highlight.FillColor =
			healthColor

		label.TextColor3 =
			healthColor

		label.Text =
			string.format(
				"%s [%d/%d]",
				target.Name,

				math.max(
					0,
					math.floor(
						humanoid.Health
					)
				),

				math.floor(
					humanoid.MaxHealth
				)
			)
	end

	local connection =
		RunService.Heartbeat:Connect(
			update
		)

	espObjects[target] = {

		highlight,
		billboard,
		connection

	}

	update()
end

local function updateESP()

	if not getESP() then

		for target in pairs(
			espObjects
		) do

			removeESP(target)
		end

		return
	end

	for _,target in ipairs(
		Players:GetPlayers()
	) do

		if target ~= player
			and not espObjects[target] then

			addESP(target)
		end
	end
end

