--==================================================
-- MAIN LOOP
--==================================================

RunService.Heartbeat:Connect(
	function(dt)

		local character =
			getCharacter()

		local humanoid =
			getHumanoid()

		local root =
			getRoot()

		-- WALK SPEED / JUMP POWER
		if humanoid then

			humanoid.WalkSpeed =
				getWalkSpeed()

			humanoid.JumpPower =
				getJumpPower()
		end

		-- NOCLIP
		if character
			and getNoclip() then

			for _,part in ipairs(
				character:GetDescendants()
			) do

				if part:IsA(
					"BasePart"
				) then

					part.CanCollide =
						false
				end
			end
		end

		-- FLY
		if getFly()
			and humanoid
			and root
			and not surfaceAttached then

			humanoid.PlatformStand =
				true

			local move =
				humanoid.MoveDirection

			local camera =
				workspace.CurrentCamera

			if move.Magnitude > 0
				and camera then

				root.AssemblyLinearVelocity =
					camera.CFrame.LookVector *
					getFlySpeed()

			else

				root.AssemblyLinearVelocity =
					Vector3.zero
			end

		else

			if humanoid
				and humanoid.PlatformStand
				and not getFly() then

				humanoid.PlatformStand =
					false
			end
		end

		-- WALK FLING
		if getWalkFling()
			and root
			and not surfaceAttached then

			root.AssemblyAngularVelocity =
				Vector3.new(
					0,
					100000,
					0
				)

			for _,target in ipairs(
				Players:GetPlayers()
			) do

				if target ~= player then

					local targetRoot =
						target.Character
						and target.Character:
						FindFirstChild(
							"HumanoidRootPart"
						)

					if targetRoot then

						local distance =
							(
								targetRoot.Position -
								root.Position
							).Magnitude

						if distance <= 4 then

							local last =
								flingCooldown[
									target
								]
								or 0

							if os.clock() -
								last >= 0.5 then

								local difference =
									targetRoot.Position -
									root.Position

								if difference.Magnitude >
									0 then

									local direction =
										difference.Unit

									targetRoot.AssemblyLinearVelocity =
										direction *
										100 +
										Vector3.new(
											0,
											60,
											0
										)

									flingCooldown[
										target
									] =
										os.clock()
								end
							end
						end
					end
				end
			end

		else

			if root
				and not surfaceAttached then

				root.AssemblyAngularVelocity =
					Vector3.zero
			end
		end

		-- ANTI FLING
		if getAntiFling() then

			for _,target in ipairs(
				Players:GetPlayers()
			) do

				if target ~= player
					and target.Character then

					for _,part in ipairs(
						target.Character:
						GetDescendants()
					) do

						if part:IsA(
							"BasePart"
						) then

							part.CanCollide =
								false
						end
					end
				end
			end
		end

		updateESP()

		-- UNIVERSAL SURFACE WALK
		updateWallWalk(dt)
	end
)

--==================================================
-- RESPAWN
--==================================================

player.CharacterAdded:Connect(
	function(character)

		if surfaceAttached then
			stopSurfaceCamera()
		end

		surfaceNormal =
			nil

		surfacePart =
			nil

		surfaceAttached =
			false

		local humanoid =
			character:WaitForChild(
				"Humanoid"
			)

		task.wait(0.2)

		humanoid.WalkSpeed =
			getWalkSpeed()

		humanoid.JumpPower =
			getJumpPower()

		humanoid.AutoRotate =
			true

		local camera =
			workspace.CurrentCamera

		if camera then

			camera.CameraType =
				Enum.CameraType.Custom

			camera.CameraSubject =
				humanoid
		end

		if getESP() then

			task.wait(0.5)

			updateESP()
		end
	end
)
