--==================================================
-- DRAGGING
--==================================================

local draggingMenu = false
local dragStart
local startPosition

local function isInsideInteractive(object)

	if not object then
		return false
	end

	local current =
		object

	while current
		and current ~= window do

		if current:IsA("GuiButton")
			or current:IsA("TextBox") then

			return true
		end

		if current == nav
			or current == content
			or current == colorList
			or current == savedList then

			return true
		end

		current =
			current.Parent
	end

	return false
end

window.InputBegan:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			if not isInsideInteractive(
				input.Target
			) then

				draggingMenu =
					true

				dragStart =
					input.Position

				startPosition =
					window.Position
			end
		end
	end
)

UserInputService.InputChanged:Connect(
	function(input)

		if not draggingMenu then
			return
		end

		if input.UserInputType ==
			Enum.UserInputType.MouseMovement
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			local delta =
				input.Position -
				dragStart

			window.Position =
				UDim2.new(
					startPosition.X.Scale,
					startPosition.X.Offset +
						delta.X,

					startPosition.Y.Scale,
					startPosition.Y.Offset +
						delta.Y
				)
		end
	end
)

UserInputService.InputEnded:Connect(
	function(input)

		if input.UserInputType ==
			Enum.UserInputType.MouseButton1
			or input.UserInputType ==
			Enum.UserInputType.Touch then

			draggingMenu =
				false
		end
	end
)

