local function getCurrentSettings()

	return {

		created = os.time(),

		walkSpeed =
			getWalkSpeed(),

		jumpPower =
			getJumpPower(),

		infiniteJump =
			getInfiniteJump(),

		fly =
			getFly(),

		flySpeed =
			getFlySpeed(),

		esp =
			getESP(),

		noclip =
			getNoclip(),

		walkFling =
			getWalkFling(),

		wallWalk =
			getWallWalk(),

		antiFling =
			getAntiFling(),

		background =
			currentBackground
	}
end

local function applySettings(data)

	if not data then
		return
	end

	setWalkSpeed(
		data.walkSpeed or 16
	)

	setJumpPower(
		data.jumpPower or 50
	)

	setInfiniteJump(
		data.infiniteJump or false
	)

	setFly(
		data.fly or false
	)

	setFlySpeed(
		data.flySpeed or 60
	)

	setESP(
		data.esp or false
	)

	setNoclip(
		data.noclip or false
	)

	setWalkFling(
		data.walkFling or false
	)

	setWallWalk(
		data.wallWalk or false
	)

	setAntiFling(
		data.antiFling or false
	)

	if data.background then
		setBackground(
			data.background
		)
	end
end

local function clearSavedList()

	for _,child in ipairs(
		savedList:GetChildren()
	) do

		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
end

local function refreshSavedList()

	clearSavedList()

	local sorted = {}

	for _,file in ipairs(
		savedPresets
	) do

		table.insert(
			sorted,
			file
		)
	end

	table.sort(
		sorted,
		function(a,b)
			return
				a.data.created >
				b.data.created
		end
	)

	for _,file in ipairs(
		sorted
	) do

		local button =
			Instance.new(
				"TextButton"
			)

		button.Size =
			UDim2.new(
				1,
				-10,
				0,
				48
			)

		button.BackgroundColor3 =
			ELEMENT

		button.Text =
			""

		button.AutoButtonColor =
			false

		button.Parent =
			savedList

		round(button,8)

		local nameLabel =
			Instance.new(
				"TextLabel"
			)

		nameLabel.BackgroundTransparency =
			1

		nameLabel.Position =
			UDim2.new(
				0,
				10,
				0,
				4
			)

		nameLabel.Size =
			UDim2.new(
				1,
				-20,
				0,
				20
			)

		nameLabel.Font =
			Enum.Font.GothamBold

		nameLabel.Text =
			file.name

		nameLabel.TextColor3 =
			WHITE

		nameLabel.TextSize =
			12

		nameLabel.TextXAlignment =
			Enum.TextXAlignment.Left

		nameLabel.Parent =
			button

		local dateLabel =
			Instance.new(
				"TextLabel"
			)

		dateLabel.BackgroundTransparency =
			1

		dateLabel.Position =
			UDim2.new(
				0,
				10,
				0,
				24
			)

		dateLabel.Size =
			UDim2.new(
				1,
				-20,
				0,
				18
			)

		dateLabel.Font =
			Enum.Font.Gotham

		dateLabel.Text =
			os.date(
				"%b %d, %Y • %I:%M %p",
				file.data.created
			)

		dateLabel.TextColor3 =
			GRAY

		dateLabel.TextSize =
			9

		dateLabel.TextXAlignment =
			Enum.TextXAlignment.Left

		dateLabel.Parent =
			button

		button.MouseButton1Click:Connect(
			function()

				fileNameBox.Text =
					file.name

				applySettings(
					file.data
				)

				savedList.Visible =
					false

				loadButton.Text =
					"Load File     ▼"
			end
		)
	end
end

saveButton.MouseButton1Click:Connect(
	function()

		local name =
			fileNameBox.Text

		if name == "" then
			name =
				"Unnamed File"
		end

		local data =
			getCurrentSettings()

		local existing

		for _,file in ipairs(
			savedPresets
		) do

			if file.name == name then

				existing =
					file

				break
			end
		end

		if existing then

			existing.data =
				data

		else

			table.insert(
				savedPresets,
				{
					name = name,
					data = data
				}
			)
		end

		refreshSavedList()
	end
)

loadButton.MouseButton1Click:Connect(
	function()

		savedList.Visible =
			not savedList.Visible

		if savedList.Visible then

			loadButton.Text =
				"Load File     ▲"

			refreshSavedList()

		else

			loadButton.Text =
				"Load File     ▼"
		end
	end
)

